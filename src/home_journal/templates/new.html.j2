<html>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1"
    />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="google" content="notranslate" />
    <title>new post</title>
    <link href="css/beer.min.css" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" />

    <script type="module" src="js/beer.min.js"></script>
    <script type="module" src="js/material-dynamic-colors.min.js"></script>
    <script src="/js/new.js?v=locations-1"></script>
    <script src="/js/site.js"></script>
  </head>

  <body class="dark">
    <nav class="bottom no-margin">
      <a href="" onclick="changeMode()">
        <i>light_mode</i>
        <div>Mode</div>
      </a>
      <a href="/">
        <i>home</i>
        <div>Home</div>
      </a>
      <a href="/new.html">
        <i>add</i>
        <div>New</div>
      </a>
    </nav>
    <div class="modal modal_status" id="status">
      <h5>Submitting</h5>
      <div>Progress: <span id="progress_text"></span></div>
      <div class="small-space"></div>
      <div class="small-space border">
        <div class="progress left" id="progress"></div>
      </div>
    </div>
    <main
      class="responsive"
      style="min-height: 100dvh; display: flex; flex-direction: column;"
    >
      <div class="s12 page-title">
        <h2>post</h2>
      </div>
      <div
        class="s12"
        style="flex-grow: 1; display: flex; flex-direction: column;"
        id="main_body"
      >
        <article class="new-post" style=" flex-grow: 1;">
          <form
            action="/"
            method="post"
            enctype="multipart/form-data"
            autocomplete="off"
            id="form"
            data-max-upload-size="{{ max_upload_size }}"
          >
            <div class="grid no-space">
              <div class="s12">
                <div class="field label border round">
                  <input type="text" name="title" required />
                  <label>Title</label>
                </div>
              </div>
              <div class="s12">
                {% if authors %}
                  <div class="field label suffix border round">
                    <select name="author" id="author" required>
                      {% for author in authors %}
                        <option value="{{ author }}">{{ author }}</option>
                      {% endfor %}
                    </select>
                    <label>Author</label>
                    <i>arrow_drop_down</i>
                  </div>
                {% else %}
                  <div class="field label border round">
                    <input
                      type="text"
                      name="author"
                      id="author"
                      required
                      autocomplete="name"
                    />
                    <label>Author</label>
                  </div>
                {% endif %}
              </div>
              {% if tags %}
                <div class="s12">
                  <span style="font-size: 1rem" ;>Common tags</span>
                </div>
                <div class="s12 small-space"></div>
                {% for tag in tags | sort %}
                  <div class="s4 m3">
                    <label class="checkbox">
                      <input type="checkbox" name="tag-{{ tag }}" />
                      <span>{{ tag|capitalize }}</span>
                    </label>
                  </div>
                {% endfor %}
                <div class="large-space"></div>
              {% endif %}
              <div class="s12">
                <div class="field label border round">
                  <input type="text" name="tags" />
                  <label>Custom tags</label>
                </div>
              </div>
              <div class="s12">
                <div class="field label border round">
                  <input
                    type="text"
                    name="location_name"
                    id="location_name"
                    list="places"
                    autocomplete="off"
                    required
                  />
                  <label>Location</label>
                </div>
                <input type="hidden" name="location_lat" id="location_lat" />
                <input type="hidden" name="location_lon" id="location_lon" />
                <input type="hidden" name="location_source" id="location_source" />
                <datalist id="places">
                  {% for place in places %}
                    <option
                      value="{{ place.name | e }}"
                      data-lat="{{ place.lat }}"
                      data-lon="{{ place.lon }}"
                    ></option>
                  {% endfor %}
                </datalist>
                <div class="row">
                  <button
                    type="button"
                    class="border round small"
                    onclick="useMyLocation()"
                  >
                    <i>my_location</i>
                    Use my location
                  </button>
                </div>
                <p
                  id="location_status"
                  style="font-size: 0.8rem; color: var(--outline);"
                >
                  Required. Type a place or use your location.
                </p>
              </div>
              <div class="s12">
                <div class="field textarea label border extra round">
                  <textarea id="content" name="content" required></textarea>
                  <label>Content</label>
                </div>
              </div>
              <div class="s12">
                <div class="field label prefix border round">
                  <i>attach_file</i>
                  <input type="text" />
                  <input type="file" name="media" id="media" multiple />
                  <label>Media</label>
                </div>
              </div>
              <div class="s12">
                <button
                  class="absolute right circle extra"
                  type="submit"
                  onclick="store()"
                >
                  <i>arrow_forward</i>
                </button>
              </div>
            </div>
          </form>
        </article>
      </div>
    </main>
  </body>
</html>
